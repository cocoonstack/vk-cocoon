# vk-cocoon environment overrides. Drop a customized copy at
# /etc/cocoon/vk-cocoon.env on each cocoon node.

# Virtual node name registered with the K8s API.
VK_NODE_NAME=cocoon-pool

# Cocoon pool label stamped onto the registered node.
VK_NODE_POOL=default

# Guest-visible CPU ABI class stamped as cocoonstack.io/snapshot-cpu-class.
# CocoonSets with spec.snapshotCompatibilityClass schedule only onto an exact
# match, and vk-cocoon refuses a classified pod on any other node. Name a
# certified CPU model (e.g. n2-cascade-lake-v1), never a bare architecture.
#VK_SNAPSHOT_CPU_CLASS=

# Cloud-provider backing instance for the virtual node. On GKE this
# prevents the cloud node lifecycle controller from deleting the
# virtual node as "not found in cloud provider".
#VK_PROVIDER_ID=gce://<project>/<zone>/<instance>

# Kubeconfig used to talk to the API server. The systemd unit
# already exports KUBECONFIG=/etc/cocoon/kubeconfig; uncomment to
# override.
#KUBECONFIG=/etc/cocoon/kubeconfig

# Log level for the projecteru2/core/log facade.
VK_LOG_LEVEL=info

# OCI registry base for snapshots & cloud images (Artifact Registry
# repo). Required.
OCI_REGISTRY=asia-southeast1-docker.pkg.dev/PROJECT/REPO

# GCP service-account JSON key with roles/artifactregistry.writer, for snapshot
# push. Uncomment ONLY after the key exists — a missing path makes ADC fail
# (anonymous) instead of falling back to the read-only node instance SA.
#GOOGLE_APPLICATION_CREDENTIALS=/etc/cocoon/cocoon-ar-writer.json

# cocoon-net JSON lease file path (default shown).
VK_LEASES_PATH=/var/lib/cocoon/net/leases.json

# Path to the cocoon CLI binary. Empty defaults to /usr/local/bin/cocoon.
#VK_COCOON_BIN=

# Orphan-VM policy applied during startup reconcile:
#   alert    log + metric, do not touch the VM (safest)
#   destroy  remove the orphan VM (the built-in default when unset)
#   keep     no log, no metric
VK_ORPHAN_POLICY=alert

# Plain-HTTP metrics listener.
VK_METRICS_ADDR=:9091

# Percentage of host resources held back from node Allocatable (0-100).
# Align with cocoon's cgroup_cpus fence so the accounting reserve matches
# the physically fenced cores (e.g. 16-core host, cgroup_cpus=0-12 → 20).
#VK_RESERVE_PERCENT=20

# cgroup v2 slice holding cocoon's per-VM CPU scopes; must match
# cocoon's cgroup_parent config. Per-VM CPU usage and throttling stats
# are read from <slice>/vm-<id>.scope.
#COCOON_CGROUP_PARENT=cocoon.slice

# Snapshot transfer wire-format knobs (design: cocoon-specs
# snapshot-transfer-acceleration). All unset/zero = phase 1: pushes keep the
# v1 writer, the v2 reader is always on. Set them ONLY after the whole fleet
# and the snapshot tooling run a v2-capable reader; phase-2 defaults get
# pinned by the measurement spike before any rollout.
#SNAPSHOT_ZSTD_LEVEL=3            # 0 = no compression
#SNAPSHOT_CHUNK_SIZE_MIB=512      # 0 = no chunking
#SNAPSHOT_TRANSFER_CONCURRENCY=8  # parallel chunk transfers, 0 = default (8)
#SNAPSHOT_MEMORY_BUDGET_MIB=9216  # push pipeline buffer cap, 0 = default
#SNAPSHOT_PULL_BUDGET_MIB=2048    # pull prefetch cap per active pull, 0 = default
